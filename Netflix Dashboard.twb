            <column caption='Show Id' datatype='integer' name='[show_id]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0i7dzh508srfq91euhny904esk21].[none:listed_in:nk]'>
